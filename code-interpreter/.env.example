# Code Interpreter stack configuration.
#
# Lives on the host at /etc/komodo/stacks/code-interpreter/code-interpreter/.env,
# root-owned 600. Do not fill this in by hand: scripts/codeapi-secrets.sh
# generates every value below *and* the matching half that goes into
# librechat/.env, since the two files share one keypair and must agree.
#
# Like librechat/, these are interpolated into the compose file's explicit
# environment, so Komodo's merged-config log can contain them (see LEARNING.md).

# --- LibreChat's tokens ---
# The public half of LibreChat's Ed25519 signing key, as a JWK set. Not a
# secret on its own, but it is half of a pair generated per host. Single-quoted
# so compose takes the JSON literally.
CODEAPI_JWT_JWKS_JSON='{"keys":[{"kty":"OKP","crv":"Ed25519","x":"changeme","kid":"changeme","alg":"EdDSA","use":"sig"}]}'

# --- Execution manifests ---
# Ed25519 keypair, base64 DER (PKCS#8 private, SPKI public). The worker signs
# every job; the sandbox runner refuses anything this public key does not verify.
CODEAPI_EXECUTION_MANIFEST_PRIVATE_KEY=changeme
SANDBOX_EXECUTION_MANIFEST_PUBLIC_KEY=changeme

# --- Shared service secrets ---
# Generate each: openssl rand -hex 32
CODEAPI_INTERNAL_SERVICE_TOKEN=changeme
CODEAPI_EGRESS_GRANT_SECRET=changeme
# At least 32 bytes, or the API refuses to start in hardened mode.
CODEAPI_BRIDGE_TOKEN=changeme
REDIS_PASSWORD=changeme

# --- Storage (Floci S3) ---
# Not an access control — Floci accepts any credentials; the private network
# is the boundary (see the compose file). Random anyway.
STORAGE_ACCESS_KEY=changeme
STORAGE_SECRET_KEY=changeme
