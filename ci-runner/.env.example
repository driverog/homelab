# Host .env beside the checkout: /etc/komodo/stacks/ci-runner/ci-runner/.env,
# root-owned, 600. Never commit .env. Both values are read only by the first
# start, which registers the runner; after that the registration lives in the
# runner-home volume.

# The repository this runner takes jobs from: https://github.com/<owner>/<repo>.
# Register it on one private repo, never an org that also has public repos:
# a runner a public repo can use runs code from strangers' pull requests.
RUNNER_REPO_URL=

# One-time registration token, from that repo's Settings → Actions → Runners
# → New self-hosted runner, or:
#   gh api -X POST repos/<owner>/<repo>/actions/runners/registration-token --jq .token
# Expires an hour after it is issued. Delete it once the runner shows as Idle.
RUNNER_TOKEN=
